# =============================================================================
# JADAI STUDIOS ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env — client-visible keys use the NEXT_PUBLIC_* names.
# =============================================================================
# NEXT_PUBLIC_* keys are injected into the browser bundle by vite.config.ts.
# Everything else is server-only (server.ts / Render environment).
#
# REQUIRED vs OPTIONAL is marked per variable. Missing optional keys degrade
# honestly (features label themselves unavailable — they never fake data).

# --- Supabase PostgreSQL (supabase.com — Free Tier) — REQUIRED ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- AI: Groq primary (console.groq.com/keys) — REQUIRED for AI features ---
# Serves all text AI (PRIME chat, artifacts, diagnostics) via openai/gpt-oss-120b.
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- AI: OpenAI secondary — OPTIONAL (needs ACTIVE CREDIT BALANCE) ---
# Without credits the server auto-parks OpenAI via an escalating breaker and
# fails over to Groq. Set only after topping up platform.openai.com billing.
OPENAI_API_KEY=sk-proj-...

# --- AI: Google Gemini tertiary — OPTIONAL (aistudio.google.com) ---
GEMINI_API_KEY=AIzaSy...

# --- Payments: Paystack (NGN + USD) — REQUIRED for payments ---
PAYSTACK_SECRET_KEY=sk_test_...       # live: sk_live_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...  # live: pk_live_...

# --- Admin auth (server-only) — REQUIRED ---
# Generate hash: npm run gen:admin-hash
SESSION_SECRET=generate_a_random_string_at_least_32_characters_long
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD_HASH=$2b$10$...
# Dev-only escape hatch (never set in production):
# ADMIN_DEV_PASSWORD=...

# --- Cron guards (cron-job.org sends this header to /api/cron/*) — REQUIRED ---
CRON_SECRET=your_cron_random_secret_string

# --- Core app config — REQUIRED in production ---
NEXT_PUBLIC_APP_URL=http://localhost:3000   # https://jadai.dev in production
NEXT_PUBLIC_APP_NAME="Jadai Studios"

# --- Media: GIPHY GIF search in PRIME chat — OPTIONAL ---
# Free key: https://developers.giphy.com/dashboard → create app → copy key.
# Without it, GIF search shows an honest "key required" message (emojis still work).
NEXT_PUBLIC_GIPHY_API_KEY=

# --- Image generation: works with NO keys (Pollinations free tier) ---
# Free tier = 1 image / 45s per IP — the server retries once and returns
# partial results with an honest note. Optional paid fallbacks:
# FAL_KEY=...                          # fal.ai FLUX (fal.run)
# HF_KEY=...                           # Hugging Face inference token

# --- Optional / advanced ---
# GOOGLE_PSI_API_KEY=AIzaSy...      # PageSpeed Insights (diagnostics)
# CORS_ORIGINS=https://jadai.dev    # defaults to NEXT_PUBLIC_APP_URL
# SERVE_STATIC=1                    # let Express serve dist/ (skip Cloudflare Pages)
# PORT=3000                         # server port (default 3000)
# DISABLE_HMR=true                  # disable Vite HMR/file-watching (AI Studio)
